# ============================================================
# CLINICO 360 — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ============================================================

# --- Application ---
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production

# --- Database ---
# Default: SQLite (zero-setup for local development)
DATABASE_URL=sqlite:///./clinico360.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://username:password@localhost:5432/clinico360

# --- AI Providers (Optional) ---
# CLINICO 360 operates with deterministic evidence-based logic without these keys.
# Providing keys enables AI-enhanced natural language generation for clinical reports.

# Google Gemini (Recommended for Indian healthcare context)
GEMINI_API_KEY=

# OpenAI (Optional alternative)
OPENAI_API_KEY=

# --- CORS ---
# Comma-separated origins (default allows localhost:3000 and 5173)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Security Notes ---
# In production:
# 1. Use a strong random SECRET_KEY (min 64 characters)
# 2. Use PostgreSQL instead of SQLite
# 3. Set ENVIRONMENT=production
# 4. Enable HTTPS
# 5. Restrict CORS_ORIGINS to your actual domain
